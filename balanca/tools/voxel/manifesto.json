{
  "_": "A lista do que o renderer 3D precisa conhecer: só o que o jogo desenha. Cada grupo é um glob em public/tiny e as opções dele; a primeira regra que pega um arquivo fica com ele. Cenário vira modelo (.glb em public/voxel, espelhando o caminho); personagens, bichos e ícones são `\"forma\": \"sprite\"` — sprites planos em pé, sem modelo, só com a linha dos pés anotada no índice. Efeitos, interface, água e espuma não entram: o renderer os trata sozinho. `finos` são ajustes à mão por cor (cor → espessura máxima). Ver tools/voxelizar.py.",
  "origem": "public/tiny",
  "destino": "public/voxel",
  "compactar": true,
  "grupos": [
    {
      "glob": "units/azul/*.png",
      "exceto": [
        "flecha",
        "clerigo_bencao"
      ],
      "variantes": {
        "vermelho": "units/vermelho"
      },
      "pesDe": "parado",
      "forma": "sprite"
    },
    {
      "glob": "feras/*.png",
      "pesDe": "parado",
      "forma": "sprite"
    },
    {
      "glob": "buildings/blue/*.png",
      "variantes": {
        "red": "buildings/red"
      },
      "forma": "caixa",
      "telhado": 0.45
    },
    {
      "glob": "buildings/oficina_nivel3.png",
      "forma": "caixa",
      "telhado": 0.45
    },
    {
      "glob": "buildings/oficina_nivel2.png",
      "profundidade": 40,
      "degrau": 8
    },
    {
      "glob": "buildings/*.png",
      "forma": "sprite"
    },
    {
      "glob": "deco/Tree[12].png",
      "larguraQuadro": 192,
      "profundidade": 72,
      "degrau": 8
    },
    {
      "glob": "deco/Tree[34].png",
      "profundidade": 72,
      "degrau": 8
    },
    {
      "glob": "deco/Stump*.png",
      "profundidade": 28
    },
    {
      "glob": "deco/Bushe*.png",
      "profundidade": 44,
      "degrau": 8
    },
    {
      "glob": "deco/Rock*.png",
      "profundidade": 36
    },
    {
      "glob": "deco/*.png",
      "profundidade": 12
    },
    {
      "glob": "recursos/jazida_*.png",
      "profundidade": 56
    },
    {
      "glob": "recursos/gnomo_choupana.png",
      "profundidade": 48
    },
    {
      "glob": "recursos/gnomo_torre.png",
      "profundidade": 48
    },
    {
      "glob": "recursos/*.png",
      "exceto": [
        "xama_avatar",
        "menino_rei_avatar"
      ],
      "forma": "sprite"
    },
    {
      "glob": "canhao/corpo.png",
      "profundidade": 40
    },
    {
      "glob": "terrain/ground.png",
      "plano": "chao",
      "grade": {
        "colunas": 4,
        "linhas": 4,
        "celula": 64
      },
      "altura": 16
    }
  ]
}
