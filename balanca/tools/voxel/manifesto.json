{
  "_": "A lista do que vira voxel: só o que o jogo desenha. Cada grupo é um glob em public/tiny e as opções dele; a saída espelha o caminho em public/voxel, trocando .png por .glb. Efeitos (fx/), interface, retratos, espuma e água ficam de fora de propósito e continuam 2D. Ver tools/voxelizar.py.",
  "origem": "public/tiny",
  "destino": "public/voxel",
  "compactar": true,
  "grupos": [
    {
      "glob": "units/azul/*.png",
      "exceto": [
        "flecha",
        "clerigo_bencao"
      ],
      "variantes": {
        "vermelho": "units/vermelho"
      },
      "pesDe": "parado",
      "meiaProfundidade": 7
    },
    {
      "glob": "feras/*.png",
      "pesDe": "parado",
      "meiaProfundidade": 10
    },
    {
      "glob": "buildings/blue/*.png",
      "variantes": {
        "red": "buildings/red"
      },
      "forma": "caixa",
      "telhado": 0.45
    },
    {
      "glob": "buildings/oficina_*.png",
      "forma": "caixa",
      "telhado": 0.45
    },
    {
      "glob": "buildings/*.png",
      "meiaProfundidade": 10
    },
    {
      "glob": "deco/Tree[12].png",
      "larguraQuadro": 192,
      "meiaProfundidade": 12
    },
    {
      "glob": "deco/Tree[34].png",
      "meiaProfundidade": 12
    },
    {
      "glob": "deco/Stump*.png",
      "meiaProfundidade": 8
    },
    {
      "glob": "deco/Bushe*.png",
      "meiaProfundidade": 8
    },
    {
      "glob": "deco/*.png",
      "meiaProfundidade": 5
    },
    {
      "glob": "recursos/*.png",
      "exceto": [
        "xama_avatar",
        "menino_rei_avatar"
      ],
      "meiaProfundidade": 8
    },
    {
      "glob": "canhao/corpo.png",
      "meiaProfundidade": 8
    },
    {
      "glob": "terrain/ground.png",
      "plano": "chao",
      "grade": {
        "colunas": 4,
        "linhas": 4,
        "celula": 64
      },
      "altura": 16
    }
  ]
}
